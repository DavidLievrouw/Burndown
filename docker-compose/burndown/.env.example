# Copy to .env (git-ignored) and fill in. Compose reads .env from this folder.

# Personal access token of the Firefly III profile (Profile > OAuth > Personal Access Tokens). It expires after about
# a year: see README.md for how to rotate it.
FIREFLY_TOKEN=

# Where the container reaches Firefly III. The default is Firefly on the Docker host, port 8042.
# FIREFLY_BASE_URL=http://host.docker.internal:8042

# Image tag; defaults to the version in version.txt.
# BURNDOWN_VERSION=1.0.0
